<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_2sdp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_patient"
        android:layout_width="70sp"
        android:layout_height="70sp"
        android:src="@drawable/patient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_6sdp"
        android:fontFamily="@font/montserrat"
        android:lineHeight="@dimen/_15sdp"
        android:text="John Doe has requested an appointment with Dr. irfan on July 15, 2023, at 2:00 PM."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_patient"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat"
        android:text="5 min ago"
        android:layout_marginTop="@dimen/_5sdp"
        app:layout_constraintBottom_toTopOf="@id/ll_action_btns"
        app:layout_constraintStart_toStartOf="@+id/tv_description"
        app:layout_constraintTop_toBottomOf="@+id/tv_description" />


    <LinearLayout
        android:id="@+id/ll_action_btns"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="@+id/tv_duration"
        app:layout_constraintTop_toBottomOf="@+id/tv_duration">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_accept"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_35sdp"
            android:backgroundTint="@color/primary_blue"
            android:fontFamily="@font/montserrat"
            android:text="Accept"
            android:textStyle="bold"
            app:cornerRadius="@dimen/_6sdp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reject"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:backgroundTint="@android:color/transparent"
            android:fontFamily="@font/montserrat"
            android:text="Reject"
            android:textColor="@color/text_gray"
            android:textStyle="bold"
            app:cornerRadius="@dimen/_6sdp"
            app:strokeColor="@color/text_gray"
            app:strokeWidth="@dimen/_1sdp" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>